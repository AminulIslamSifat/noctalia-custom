#include "shell/edge_slider/edge_slider_trigger.h"

#include "config/config_service.h"
#include "render/scene/input_area.h"
#include "shell/edge_slider/edge_slider_panel.h"
#include "shell/panel/panel_manager.h"
#include "ui/builders.h"
#include "wayland/wayland_connection.h"

#include <cstdint>

namespace {
  // Width of the invisible trigger strip on the right edge.
  constexpr std::int32_t kTriggerWidth = 6;
  // Height spans the full output (anchored top+bottom with 0 size = compositor fills).
}

EdgeSliderTrigger::EdgeSliderTrigger() = default;
EdgeSliderTrigger::~EdgeSliderTrigger() { destroySurfaces(); }

void EdgeSliderTrigger::initialize(
    WaylandConnection& wayland, ConfigService* config, RenderContext* renderContext
) {
  m_wayland = &wayland;
  m_config = config;
  m_renderContext = renderContext;
}

void EdgeSliderTrigger::onOutputChange() {
  destroySurfaces();
  ensureSurfaces();
}

void EdgeSliderTrigger::ensureSurfaces() {
  if (m_wayland == nullptr) return;

  for (const auto& out : m_wayland->outputs()) {
    if (!out.done || out.connectorName.empty()) continue;

    auto instance = std::make_unique<Instance>();
    instance->output = out.output;

    LayerSurfaceConfig surfaceConfig{
        .nameSpace = "edge_slider_trigger",
        .layer = LayerShellLayer::Top,
        .anchor = LayerShellAnchor::Top | LayerShellAnchor::Bottom | LayerShellAnchor::Right,
        .width = static_cast<std::uint32_t>(kTriggerWidth),
        .height = 0, // compositor assigns height via dual-anchor
        .exclusiveZone = -1, // ignore exclusive zones, anchor to absolute edge
    };

    instance->surface = std::make_unique<LayerSurface>(*m_wayland, surfaceConfig);
    instance->surface->initialize(out.output);

    // Query output logical height for proper input area sizing
    float outputHeight = 1080.0F; // fallback
    if (out.logicalHeight > 0) {
      outputHeight = static_cast<float>(out.logicalHeight);
    }

    auto inputArea = ui::inputArea({});
    inputArea->setPosition(0, 0);
    inputArea->setSize(static_cast<float>(kTriggerWidth), outputHeight);
    auto* outputPtr = out.output;
    inputArea->setOnEnter([this, outputPtr](const InputArea::PointerData&) {
      if (m_panel != nullptr) {
        m_panel->onTriggerEnter();
        // Open the panel if not already open
        auto& pm = PanelManager::instance();
        if (!pm.isOpenPanel("edge-slider")) {
          pm.openPanel("edge-slider", PanelOpenRequest{.output = outputPtr});
        }
      }
    });
    inputArea->setOnLeave([this]() {
      if (m_panel != nullptr) m_panel->onTriggerLeave();
    });

    instance->sceneRoot = std::move(inputArea);
    instance->inputDispatcher.setSceneRoot(instance->sceneRoot.get());

    instance->surface->setRenderContext(m_renderContext);
    instance->surface->setSceneRoot(instance->sceneRoot.get());
    instance->surface->requestRedraw();

    m_instances.push_back(std::move(instance));
  }
}

void EdgeSliderTrigger::destroySurfaces() { m_instances.clear(); }

bool EdgeSliderTrigger::onPointerEvent(const PointerEvent& event) {
  if (event.surface == nullptr) return false;

  for (const auto& instance : m_instances) {
    if (instance->surface && event.surface == instance->surface->wlSurface()) {
      switch (event.type) {
      case PointerEvent::Type::Enter:
        instance->inputDispatcher.pointerEnter(
            static_cast<float>(event.sx), static_cast<float>(event.sy), event.serial
        );
        return true;
      case PointerEvent::Type::Leave:
        instance->inputDispatcher.pointerLeave();
        return true;
      case PointerEvent::Type::Motion:
        instance->inputDispatcher.pointerMotion(
            static_cast<float>(event.sx), static_cast<float>(event.sy), event.serial
        );
        return true;
      default:
        break;
      }
      return false;
    }
  }
  return false;
}
